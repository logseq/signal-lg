(ns signal.core)

(type-record stabilization-diagnostics
  (stabilization-generation :int)
  (stabilization-rounds :int)
  (stabilization-effects :int)
  (stabilization-dirty-tasks :int))

(type-record scheduler
  (effects :ref<vector<fn<bool>>>)
  (dirty :ref<vector<fn<bool>>>)
  (generation-value :ref<int>)
  (last-stabilization-value :ref<stabilization-diagnostics>))

(type-record subscription
  (disposed :ref<bool>)
  (cancel :fn<bool>))

(type-record subscriber [value]
  (subscriber-id :int)
  (callback :fn<value;bool>))

(type-record cleanup-entry
  (cleanup-id :int)
  (cleanup-callback :fn<bool>))

(type-record signal [value]
  (owner :scheduler)
  (current :ref<value>)
  (next-subscriber-id :ref<int>)
  (subscribers :ref<vector<subscriber<value>>>)
  (upstream-subscriptions :ref<vector<subscription>>)
  (disposed-signal :ref<bool>))

(type-record state [value]
  (state-signal :signal<value>)
  (pending :ref<option<value>>)
  (scheduled :ref<bool>))

(type-record scope
  (scope-id :int)
  (scope-name :string)
  (next-cleanup-id :ref<int>)
  (cleanup-callbacks :ref<vector<cleanup-entry>>)
  (mount-callbacks :ref<vector<fn<bool>>>)
  (unmount-callbacks :ref<vector<fn<bool>>>)
  (owned-subscriptions :ref<vector<subscription>>)
  (mounted :ref<bool>)
  (disposed-scope :ref<bool>))

(type-record state-slot [value]
  (slot-name :string)
  (slot-states :ref<map<int;state<value>>>))

(type-record switch [key]
  (switch-subscription :subscription)
  (switch-scope :ref<scope>)
  (switch-disposed :ref<bool>))

(type-variant keyed-patch [key]
  (Insert :key :int)
  (Remove :key :int)
  (Move :key :int :int))

(type-record keyed-entry [key item]
  (entry-key :key)
  (entry-state :state<item>)
  (entry-scope :scope))

(type-record keyed [key item]
  (keyed-subscription :subscription)
  (keyed-entries :ref<vector<keyed-entry<key;item>>>)
  (keyed-compare :fn<key;key;int>)
  (keyed-disposed :ref<bool>))

(signature signal.core/scheduler :fn<scheduler>)
(signature signal.core/empty-callbacks :fn<vector<fn<bool>>>)
(signature signal.core/empty-cleanups :fn<vector<cleanup-entry>>)
(signature signal.core/empty-subscriptions :fn<vector<subscription>>)
(signature signal.core/generation :fn<scheduler;int>)
(signature signal.core/last-stabilization
  :fn<scheduler;stabilization-diagnostics>)
(signature signal.core/enqueue-effect! :fn<scheduler;fn<bool>;bool>)
(signature signal.core/enqueue-dirty! :fn<scheduler;fn<bool>;bool>)
(signature signal.core/schedule-once! :fn<scheduler;ref<bool>;fn<bool>;bool>)
(signature signal.core/stabilize! :fn<scheduler;bool>)

(signature signal.core/constant [value]
  :fn<scheduler;value;signal<value>>)
(signature signal.core/state [value]
  :fn<scheduler;value;state<value>>)
(signature signal.core/value [value]
  :fn<state<value>;signal<value>>)
(signature signal.core/sample [value]
  :fn<signal<value>;value>)
(signature signal.core/get [value]
  :fn<state<value>;value>)
(signature signal.core/set! [value]
  :fn<state<value>;value;bool>)
(signature signal.core/update! [value]
  :fn<state<value>;fn<value;value>;bool>)
(signature signal.core/observe [value]
  :fn<signal<value>;fn<value;bool>;subscription>)
(signature signal.core/subscribe* [value]
  :fn<signal<value>;fn<value;bool>;bool;subscription>)
(signature signal.core/dispose-subscription!
  :fn<subscription;bool>)
(signature signal.core/dispose-signal! [value]
  :fn<signal<value>;bool>)
(signature signal.core/map [left right output]
  :overload<fn<fn<left;output>;signal<left>;signal<output>>;fn<fn<left;right;output>;signal<left>;signal<right>;signal<output>>>)
(signature signal.core/cutoff [value]
  :fn<fn<value;value;bool>;signal<value>;signal<value>>)

(signature signal.core/scope
  :overload<fn<string;scope>;fn<string;scope;scope>>)
(signature signal.core/make-scope :fn<string;scope>)
(signature signal.core/on-mount! :fn<scope;fn<bool>;bool>)
(signature signal.core/on-unmount! :fn<scope;fn<bool>;bool>)
(signature signal.core/on-dispose! :fn<scope;fn<bool>;bool>)
(signature signal.core/register-cleanup!
  :fn<scope;fn<bool>;subscription>)
(signature signal.core/own! :fn<scope;subscription;subscription>)
(signature signal.core/own-signal! [value]
  :fn<scope;signal<value>;signal<value>>)
(signature signal.core/mount! :fn<scope;bool>)
(signature signal.core/dispose-scope! :fn<scope;bool>)
(signature signal.core/active? :fn<scope;bool>)
(signature signal.core/state-slot [value]
  :fn<string;state-slot<value>>)
(signature signal.core/state-at [value]
  :fn<scheduler;scope;state-slot<value>;value;state<value>>)

(signature signal.core/switch [key]
  :fn<scope;signal<key>;fn<key;key;bool>;fn<key;scope>;switch<key>>)
(signature signal.core/dispose-switch! [key]
  :fn<switch<key>;bool>)

(signature signal.core/keyed [key item]
  :fn<scope;signal<vector<item>>;fn<item;key>;fn<key;key;int>;fn<signal<item>;scope>;fn<keyed-patch<key>;bool>;keyed<key;item>>)
(signature signal.core/keyed-find-scope [key item]
  :fn<keyed<key;item>;key;scope>)
(signature signal.core/dispose-keyed! [key item]
  :fn<keyed<key;item>;bool>)
(signature signal.core/find-entry-index [key item]
  :fn<vector<keyed-entry<key;item>>;key;fn<key;key;int>;option<int>>)
(signature signal.core/key-index [key item]
  :fn<vector<item>;fn<item;key>;fn<key;key;int>;persistent-tree-map<key;int>>)
(signature signal.core/remove-entry-at [key item]
  :fn<vector<keyed-entry<key;item>>;int;vector<keyed-entry<key;item>>>)
(signature signal.core/insert-entry-at [key item]
  :fn<vector<keyed-entry<key;item>>;int;keyed-entry<key;item>;vector<keyed-entry<key;item>>>)
(signature signal.core/move-entry [key item]
  :fn<vector<keyed-entry<key;item>>;int;int;vector<keyed-entry<key;item>>>)
(signature signal.core/reconcile-keyed! [key item]
  :fn<scheduler;ref<vector<keyed-entry<key;item>>>;vector<item>;fn<item;key>;fn<key;key;int>;fn<signal<item>;scope>;fn<keyed-patch<key>;bool>;bool>)
