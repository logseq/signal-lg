opam-version: "2.0"
version: "0.1.0"
synopsis: "A small statically typed incremental runtime for LG"
description:
  "Reactive values, scoped state, lifecycle, effects, switches, and keyed collections for LG applications."
maintainer: ["Tienson Qin <tiensonqin@gmail.com>"]
authors: ["Tienson Qin"]
license: "MIT"
depends: [
  "ocaml" {>= "5.4"}
  "dune" {>= "3.17" & >= "3.17"}
  "melange" {>= "6.0"}
  "lg"
  "lg-test"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
